# Local Homey Pro address without a trailing slash.
ENERGYDECK_WIFI_SSID=your-wifi-name
ENERGYDECK_WIFI_PASSWORD=your-wifi-password

HOMEY_ADDRESS=http://192.168.0.0

# Create this API Key in Homey Web App under Settings -> API Keys.
HOMEY_TOKEN=

# These values can be filled in after running ./homey-setup.sh.
HOMEY_CHARGE_FLOW_ID=
HOMEY_CHARGER_DEVICE_ID=
HOMEY_SESSY_DEVICE_ID=
HOMEY_HOMEWIZARD_DEVICE_ID=
HOMEY_ELECTRICITY_SUMMARY_DEVICE_ID=
HOMEY_GAS_SUMMARY_DEVICE_ID=
HOMEY_SOLAR_DEVICE_ID=
HOMEY_SOLAR_SUMMARY_DEVICE_ID=
HOMEY_PRICES_VARIABLE_ID=

# All-in electricity price formula. Defaults: Netherlands/Zonneplan 2026.
ENERGYDECK_ENERGY_TAX_EX_VAT_CT=
ENERGYDECK_VAT_PERCENT=
ENERGYDECK_SUPPLIER_FEE_INCL_VAT_CT=

# Used to calculate sunrise and sunset locally. Copy these from Homey's location.
ENERGYDECK_LATITUDE=
ENERGYDECK_LONGITUDE=

# Climate card Homey temperature sensor slots (optional, up to 6 sensors).
# Customize the label names and device IDs to match your rooms/sensors.
HOMEY_CLIMATE_SENSOR_1_NAME=
HOMEY_CLIMATE_SENSOR_1_DEVICE_ID=
HOMEY_CLIMATE_SENSOR_2_NAME=
HOMEY_CLIMATE_SENSOR_2_DEVICE_ID=
HOMEY_CLIMATE_SENSOR_3_NAME=
HOMEY_CLIMATE_SENSOR_3_DEVICE_ID=
HOMEY_CLIMATE_SENSOR_4_NAME=
HOMEY_CLIMATE_SENSOR_4_DEVICE_ID=
HOMEY_CLIMATE_SENSOR_5_NAME=
HOMEY_CLIMATE_SENSOR_5_DEVICE_ID=
HOMEY_CLIMATE_SENSOR_6_NAME=
HOMEY_CLIMATE_SENSOR_6_DEVICE_ID=

# Sonos bootstrap addresses. EnergyDeck connects directly via local HTTP (port 1400)
# to discover the complete household zone topology; at least one fixed IP is required.
# A secondary IP provides fallback redundancy if the primary speaker is offline.
SONOS_BOOTSTRAP_ADDRESS=http://192.168.0.1:1400 
SONOS_BOOTSTRAP_FALLBACK_ADDRESS=http://192.168.0.2:1400

# Optional serial port for ./flash.sh (defaults to /dev/cu.wchusbserial110).
# ENERGYDECK_SERIAL_PORT=/dev/cu.wchusbserial110

# Automatic night-dimming (CrowPanel Advance hardware). 0 is max brightness, 245 is off.
# ENERGYDECK_BACKLIGHT_DAY_BRIGHTNESS=48
# ENERGYDECK_BACKLIGHT_NIGHT_BRIGHTNESS=160
# ENERGYDECK_BACKLIGHT_NIGHT_START_HOUR=23
# ENERGYDECK_BACKLIGHT_NIGHT_END_HOUR=7
# ENERGYDECK_BACKLIGHT_WAKE_DURATION_S=30

# Optional read-only thermostat programme and per-room target temperatures.
# Controller: e.g. an EvoTouch device with honeywell_thermostat_mode.
# Room slots correspond to HOMEY_CLIMATE_SENSOR_1_NAME ... _6_NAME above.
# Leave unset when the corresponding controller/room thermostat is unavailable.
HOMEY_THERMOSTAT_DEVICE_ID=
HOMEY_ROOM_THERMOSTAT_1_ID=
HOMEY_ROOM_THERMOSTAT_2_ID=
HOMEY_ROOM_THERMOSTAT_3_ID=
HOMEY_ROOM_THERMOSTAT_4_ID=
HOMEY_ROOM_THERMOSTAT_5_ID=
HOMEY_ROOM_THERMOSTAT_6_ID=
