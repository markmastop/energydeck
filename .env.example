# Local Homey Pro address without a trailing slash.
ENERGYDECK_WIFI_SSID=your-wifi-name
ENERGYDECK_WIFI_PASSWORD=your-wifi-password

HOMEY_ADDRESS=http://192.168.1.100

# Create this API Key in Homey Web App under Settings -> API Keys.
HOMEY_TOKEN=

# These values can be filled in after running ./homey-setup.sh.
HOMEY_CHARGE_FLOW_ID=
HOMEY_CHARGER_DEVICE_ID=
HOMEY_SESSY_DEVICE_ID=
HOMEY_HOMEWIZARD_DEVICE_ID=
HOMEY_ELECTRICITY_SUMMARY_DEVICE_ID=
HOMEY_GAS_SUMMARY_DEVICE_ID=
HOMEY_SOLAR_DEVICE_ID=
HOMEY_SOLAR_SUMMARY_DEVICE_ID=
HOMEY_PRICES_VARIABLE_ID=

# All-in electricity price formula. Defaults: Netherlands/Zonneplan 2026.
ENERGYDECK_ENERGY_TAX_EX_VAT_CT=9.161
ENERGYDECK_VAT_PERCENT=21.0
ENERGYDECK_SUPPLIER_FEE_INCL_VAT_CT=2.0

# Used to calculate sunrise and sunset locally. Copy these from Homey's location.
ENERGYDECK_LATITUDE=
ENERGYDECK_LONGITUDE=
